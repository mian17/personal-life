# The web BFF is the only caller of the API. Values stay server-side.
API_URL=http://127.0.0.1:3001
# Must match apps/api API_TOKEN.
API_TOKEN=change-me
# Tailscale Serve-injected identity header value (your tailnet login).
OWNER_LOGIN=lethevinh1997@gmail.com
# Dev only: set true to browse localhost without the Tailscale header. Never in prod.
DEV_AUTH_BYPASS=false
