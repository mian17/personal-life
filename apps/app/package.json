{
  "name": "@life/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "APP_DEV_SKIP_ACCESS_GATE=1 next dev -p ${WEB_PORT:-3100} -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3002} -H 127.0.0.1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --passWithNoTests",
    "test:e2e": "npm run test:e2e:prod-build && npm run test:e2e:dev-server",
    "test:e2e:prod-build": "playwright test --config playwright.config.ts",
    "test:e2e:dev-server": "playwright test --config playwright.dev.config.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@life/app-kit": "*",
    "@life/nutrition": "*",
    "@life/shared": "*",
    "@life/ui": "*",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^5.12.1",
    "server-only": "^0.0.1",
    "@life/pomodoro": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": ".",
    "testRegex": "\\.(test|spec)\\.tsx?$",
    "testPathIgnorePatterns": [
      "/.next/",
      "/test/e2e/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@life/ui$": "<rootDir>/../../packages/ui/src/index.ts",
      "^@life/nutrition$": "<rootDir>/../../packages/nutrition/src/index.ts",
      "^@life/app-kit/preference-action$": "<rootDir>/../../packages/app-kit/src/preference-action.ts",
      "^server-only$": "<rootDir>/test/stubs/server-only.ts"
    },
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(openid-client|jose|oauth4webapi)/)"
    ],
    "testEnvironment": "node"
  }
}
