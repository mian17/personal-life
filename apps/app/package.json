{
  "name": "@life/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3002} -H 127.0.0.1",
    "test": "jest --passWithNoTests",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@life/shared": "*",
    "lucide-react": "^1.47.0",
    "next": "^15.2.4",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts", "tsx"],
    "rootDir": ".",
    "testRegex": "\\.(test|spec)\\.tsx?$",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^server-only$": "<rootDir>/test/stubs/server-only.ts"
    },
    "transform": {
      "^.+\\.(t|j)sx?$": ["ts-jest", { "tsconfig": "tsconfig.test.json" }]
    },
    "transformIgnorePatterns": ["/node_modules/(?!(openid-client|jose|oauth4webapi)/)"],
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/.next/"]
  }
}
