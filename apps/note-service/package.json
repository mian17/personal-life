{
  "name": "@life/note-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "PORT=${PORT:-3001} node dist/main.js",
    "backfill-owner": "ts-node scripts/backfill-owner.ts",
    "backfill-encrypt": "ts-node scripts/encrypt-backfill.ts",
    "backfill-content-updated-at": "ts-node scripts/backfill-content-updated-at.ts",
    "rotate-master-key": "ts-node scripts/rotate-master-key.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "jest"
  },
  "dependencies": {
    "@life/cache": "*",
    "@life/crypto": "*",
    "@life/db": "*",
    "@life/service-kit": "*",
    "@life/shared": "*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/typeorm": "^11.0.0",
    "better-sqlite3": "^11.8.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^6.2.15",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(\\.e2e-spec|\\.test)\\.ts$",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "moduleNameMapper": {
      "^@life/cache$": "<rootDir>/../../packages/cache/src/index.ts",
      "^@life/db$": "<rootDir>/../../packages/db/src/index.ts",
      "^@life/crypto$": "<rootDir>/../../packages/crypto/src/index.ts",
      "^@life/shared$": "<rootDir>/../../packages/shared/src/index.ts",
      "^@life/shared/node$": "<rootDir>/../../packages/shared/src/node.ts",
      "^@life/service-kit$": "<rootDir>/../../packages/service-kit/src/index.ts"
    },
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(jose)/)"
    ],
    "testEnvironment": "node"
  }
}
