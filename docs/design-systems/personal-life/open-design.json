{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "design-system-personal-life",
  "title": "Personal Life",
  "title_i18n": {
    "en": "Personal Life"
  },
  "version": "0.1.0",
  "publishedAt": "2026-10-29T12:20:36Z",
  "description": "Dark-first personal-app design system: 640px document column, one blue accent, flat panel surfaces, 12px rows and a single floating action button.",
  "description_i18n": {
    "en": "Dark-first personal-app design system: 640px document column, one blue accent, flat panel surfaces, 12px rows and a single floating action button."
  },
  "license": "MIT",
  "tags": [
    "design-system",
    "first-party",
    "design",
    "personal-life"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "design-system",
    "scenario": "design",
    "surface": "web",
    "useCase": {
      "query": {
        "en": "Generate a {{artifactKind}} using the Personal Life design system. Stay faithful to its colour palette, typography, spacing, iconography, and component vocabulary as documented in DESIGN.md."
      }
    },
    "inputs": [
      {
        "name": "artifactKind",
        "label": "Artifact kind",
        "type": "select",
        "options": [
          "app screen",
          "notes screen",
          "todo list screen",
          "settings screen",
          "landing page"
        ],
        "default": "app screen"
      },
      {
        "name": "brief",
        "label": "Brief",
        "type": "text",
        "placeholder": "What should the screen hold?"
      }
    ],
    "context": {
      "designSystem": {
        "ref": "user:personal-life",
        "primary": true
      },
      "assets": [
        "./DESIGN.md"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": [
            "file-write"
          ]
        }
      ]
    },
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
