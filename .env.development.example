# Copy to .env.development and fill in. This file is tracked; .env.development is gitignored.
#
# Loaded by `npm run dev` (root package.json) for local development only.
# Production uses the separate root `.env` consumed by Docker Compose.
#
# Placeholders only — never put real secrets in this file.

# The Tailscale access gate (reachability) is production-only; dev has no
# Tailscale header. The IdP login/session gate runs in every environment.
NODE_ENV=development

# Throwaway DB. Relative paths resolve to apps/note-service/ (the API's cwd).
DB_PATH=data/scratch.db

# Dev API/Web ports (tags :3104, todo :3105 are set by the root dev script).
PORT=3101
WEB_PORT=3100

# The web BFF is the only caller of the API. Values stay server-side.
API_URL=http://127.0.0.1:3101
# BFF routes to the ecosystem services (SPEC-service-kernel transport contract).
TAGS_API_URL=http://127.0.0.1:3104
TODO_API_URL=http://127.0.0.1:3105
FEEDBACK_API_URL=http://127.0.0.1:3108
MEAL_API_URL=http://127.0.0.1:3106
FOCUS_API_URL=http://127.0.0.1:3107
MEDITATION_API_URL=http://127.0.0.1:3109

# Service-to-service: focus-service -> todo-service. Focus reads the owner's open
# tasks so a pomodoro block can be tied to one; it only ever READS that id (it never
# creates or ticks one). No default in code on purpose — a guessed port dials the
# wrong service — so it is stated here. `scripts/setup-dev-env.sh` writes it too, and
# an env file older than that script lacks it, which leaves the "Finished that
# task?" prompt unreachable.
FOCUS_TODOS_API_URL=http://127.0.0.1:3105

# --- feedback service (feedback-service chapter, dev) ------------------------
# Dev runs against its own throwaway pair (`npm run dev:infra:up`; `npm run
# dev:infra:down` tears it down, and `npm run dev` / `npm run dev:build` start it
# automatically on ports prod does not own). The service exits **fail-closed** at
# boot without FEEDBACK_DB_URL and FEEDBACK_MASTER_KEY; without RABBITMQ_URL it
# still boots, but dispatch retries until the broker appears (the event log
# holds every event).
# FEEDBACK_DB_URL=postgresql://feedback:<FEEDBACK_DB_PASSWORD>@127.0.0.1:5433/feedback
# RABBITMQ_URL=amqp://feedback:<FEEDBACK_RABBITMQ_PASSWORD>@127.0.0.1:5673
# Generate with `openssl rand -base64 32` (never commit real values).
# FEEDBACK_MASTER_KEY=

# --- focus-service (pomodoro focus stats, dev) -------------------------------
# Focus sessions live in their own database on the same throwaway Postgres
# `scripts/dev-infra.sh` owns (5433), which creates it on `up`. Like
# feedback-service the service exits fail-closed at boot without FOCUS_DB_URL and
# FOCUS_MASTER_KEY; FOCUS_API_URL above is what the BFF reads.
# FOCUS_DB_URL=postgresql://feedback:<FEEDBACK_DB_PASSWORD>@127.0.0.1:5433/focus
# Generate with `openssl rand -base64 32` (never commit real values).
# FOCUS_MASTER_KEY=

# --- meditation-service (meditation-app chapter, dev) -----------------------
# The service keeps its rows in its own SQLite file beside the other file-backed
# services, so dev needs no database server for it. The override below is the
# workspace default; uncomment only to point dev at a different file.
# MEDITATION_DB_PATH=data/meditation.db
# Generate with `openssl rand -base64 32` (never commit real values). The service
# exits fail-closed at boot without it.
# MEDITATION_MASTER_KEY=

# --- content-encryption master keys (todo-ecosystem) ------------------------
# Per-service key custody (MAP M3). Generate each for dev with
# `openssl rand -base64 32` and paste below (never commit real values).
# TAGS_MASTER_KEY=
# TODO_MASTER_KEY=
# MEAL_MASTER_KEY=

# --- todo-service reminders (todo-due-repeat-notify, dev) --------------------
# IANA zone the service resolves local ⇄ UTC due times against. Defaults to
# Asia/Ho_Chi_Minh when unset.
TODO_TIMEZONE=Asia/Ho_Chi_Minh

# Web Push (VAPID) application-server credentials (dev). Generate once with
#   npx web-push generate-vapid-keys
# Unset ⇒ the reminder sweep logs once and stays off; the service still boots.
# TODO_VAPID_PUBLIC_KEY=
# TODO_VAPID_PRIVATE_KEY=
# TODO_VAPID_SUBJECT=mailto:you@example.com

# Tailscale Serve-injected identity header value. In dev the gates are skipped,
# so this is unused; it only matters for production.
OWNER_LOGIN=your-login@example.com

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1

# --- IdP / OIDC (Task 8b, dev) ----------------------------------------------
# `npm run dev` (root) starts all three services — note-service (:3101), the app
# (:3100) and the IdP (:3102) — so no second terminal or extra env is needed.
# The RP secret may stay the obviously-fake dev value outside production.
#
# The dev user is seeded automatically on every `npm run dev` (idempotent).
# `npm run dev:seed` reads THIS file (explicit env still wins), so a SEED_* override
# below changes what gets seeded. A bare `npm run seed -w apps/idp` reads only the
# process environment — by design, so a stray dev file can never affect production:
# it creates `dev` / `dev-password-not-a-secret` in the scratch DB if missing and
# does nothing if it already exists. Override with DEV_SEED_USERNAME/… only if you
# want a different pair; to seed manually use:
#   npm run dev:seed            (or: SEED_USERNAME=… SEED_PASSWORD=… npm run seed -w apps/idp)
#
# Seeding/db targeting: outside NODE_ENV=production the IdP uses the throwaway
# `apps/idp/data/scratch.db` — the dev server and the dev seed share it, and the
# seed NEVER takes defaulted credentials in production: it refuses to touch the
# production identity DB (`apps/idp/data/idp.db`) unless NODE_ENV=production AND
# SEED_USERNAME/SEED_PASSWORD are both supplied explicitly. Production seeding is:
#   NODE_ENV=production SEED_USERNAME=... SEED_PASSWORD=... npm run seed -w apps/idp
IDP_ISSUER=http://127.0.0.1:3102
OIDC_APP_CLIENT_ID=app
# Dev-only placeholder; production requires a real value (IdP fails to boot).
OIDC_APP_CLIENT_SECRET=app-dev-client-secret-not-a-secret

# Must match the IdP's OIDC_APP_REDIRECT_URIS and the browser URL (dev web port).
# The app canonicalizes a loopback redirect to `localhost` (the host Next's
# middleware normalizes to), so this may be either spelling; both are registered.
OIDC_APP_REDIRECT_URI=http://127.0.0.1:3100/auth/callback
OIDC_APP_REDIRECT_URIS=http://localhost:3100/auth/callback,http://127.0.0.1:3100/auth/callback

# Audience/resource mapping (defaults preserve note-service).
OIDC_DEFAULT_RESOURCE=https://note-service
OIDC_AUDIENCE_MAP=https://note-service=life-api,https://tags-service=life-api,https://todo-service=life-api,https://meal-service=life-api

# --- note-service resource server (Task 10, JWT-only) ------------------------
# note-service verifies access tokens offline against the IdP's JWKS. In dev it
# reaches the local IdP directly. In production this defaults to the internal
# compose network (`http://idp:3003/jwks`).
#
# (Dev only; production defaults are set in compose.yaml.)
# NOTE_SERVICE_IDP_JWKS_URL=http://127.0.0.1:3102/jwks
# NOTE_SERVICE_AUDIENCE=life-api

# --- content-encryption master key (data-privacy chapter) --------------------
# Envelope-encryption KEK for note/tag content at rest. 32 bytes base64.
# Generate per environment (never commit, never reuse across environments):
#   openssl rand -base64 32
# Uncomment and fill in for dev; production requires it in the server's .env
# (compose fails fast without it). Losing this key means losing access to
# encrypted content — keep a backup outside the repo.
# NOTE_MASTER_KEY=

# --- meal-service photo pipeline (meal-nutrition chapter, dev) ---------------
# Gemini coordinates (SPEC-meal-service: model id and API base come from env,
# never hardcoded). All three are required before the photo estimate turns on;
# unset ⇒ the estimate answers its explicit failure shape and the service still
# boots (the client is built on first request). Generate the key in Google AI
# Studio; keep it out of git.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_API_BASE=
# USDA FoodData Central key (SPEC-usda-source). Required before the photo
# estimate can resolve a food USDA-side; unset ⇒ that item falls to the absent
# vector and the service still boots (the client is built on first lookup).
# The key rides the QUERY STRING, so any logged URL leaks it — data.gov
# deactivates published keys. Get one at https://fdc.nal.usda.gov/api-key.
# `DEMO_KEY` is the public exploratory value (rate-limited 30/hour, 50/day).
# USDA_API_BASE is optional; it defaults to https://api.nal.usda.gov/fdc and
# only a proxy needs to override it.
# USDA_API_KEY=
# USDA_API_BASE=
# REDIS_URL=  (prod-only; compose injects redis://redis-meal — dev/e2e run Redis-free)

# --- dev:build access-gate opt-out ------------------------------------------
# `next start` forces NODE_ENV=production on its process, so a `npm run dev:build`
# run would otherwise enforce the Tailscale ACCESS gate and 403 header-less
# localhost. `dev:build` sets APP_DEV_SKIP_ACCESS_GATE=1 on the app command line
# only, restoring the same "login, not forbid" behavior as `npm run dev`.
# NEVER set this in production — it disables the owner device check.

# --- e2e harness (apps/app/test/e2e) ----------------------------------------
# Read by both Playwright configs (test/e2e/env-file.ts), so `npm run test:e2e`
# from the repo root picks these up without prefixing the command. Only
# harness-owned names are adopted — master keys and DB passwords in this file
# never reach a harness child process. Shell values win over the file.
#
# Slots this machine hands out to concurrent e2e runs, 1-9 (default 1: one run
# builds and binds at a time, every other attempt queues). Raise only when the
# box can build that many stacks at once — five parallel `next build`s OOM a
# 16 GB machine.
# E2E_CONCURRENCY=1
# How long an attempt queues before it reports E2E_QUEUE_TIMEOUT (ms).
# E2E_QUEUE_ACQUIRE_GRACE_MS=480000
# How long a claim may go unreleased before a dead run's slot is reclaimed (ms).
# E2E_SLOT_MAX_AGE_MS=1800000
