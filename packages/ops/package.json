{
  "name": "@life/ops",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "life-ops": "dist/cli/run.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp/server": {
      "types": "./dist/mcp/server.d.ts",
      "default": "./dist/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@life/shared": "*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3",
    "zod": "^3.25.76"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "\\.test\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@life/shared$": "<rootDir>/../shared/src/index.ts"
    }
  },
  "peerDependencies": {
    "@life/shared": "*"
  }
}
