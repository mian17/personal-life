{
  "name": "@life/service-kit",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "jest"
  },
  "peerDependencies": {
    "@life/crypto": "*",
    "@life/shared": "*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/typeorm": "^11.0.0",
    "jose": "^6.2.12",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@life/crypto": "*",
    "@life/shared": "*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/testing": "^11.0.11",
    "@nestjs/typeorm": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "typeorm": "^0.3.20",
    "typescript": "^5.7.3",
    "jose": "^6.2.12"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "\\.test\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@life/shared$": "<rootDir>/../shared/src/index.ts",
      "^@life/crypto$": "<rootDir>/../crypto/src/index.ts"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(jose)/)"
    ]
  }
}
