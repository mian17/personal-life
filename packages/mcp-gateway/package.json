{
  "name": "@life/mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "mcp-gateway": "dist/server.js"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:unit": "jest"
  },
  "devDependencies": {
    "@life/shared": "*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "\\.test\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@life/shared$": "<rootDir>/../shared/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "peerDependencies": {
    "@life/shared": "*"
  }
}
