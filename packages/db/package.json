{
  "name": "@life/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "db:backup": "node --loader ts-node/esm scripts/backup.ts",
    "db:restore": "node --loader ts-node/esm scripts/restore.ts",
    "db:backup:pg": "node --loader ts-node/esm scripts/backup-pg.ts",
    "db:restore:pg": "node --loader ts-node/esm scripts/restore-pg.ts"
  },
  "dependencies": {
    "@life/shared": "*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "mts"
    ],
    "rootDir": ".",
    "testRegex": "\\.test\\.(ts|mts)$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.mts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.esm-test.json"
        }
      ],
      "^.+\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".mts"
    ],
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@life/shared/node$": "<rootDir>/../shared/src/node.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
