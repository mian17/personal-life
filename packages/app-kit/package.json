{
  "name": "@life/app-kit",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./preference-action": "./src/preference-action.ts"
  },
  "scripts": {
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest"
  },
  "dependencies": {
    "@life/ui": "*"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  },
  "jest": {
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "rootDir": ".",
    "testRegex": "\\.test\\.tsx?$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^next/navigation$": "<rootDir>/test/stubs/next-navigation.tsx",
      "^next/headers$": "<rootDir>/test/stubs/next-headers.ts",
      "^next/cache$": "<rootDir>/test/stubs/next-cache.ts"
    },
    "testEnvironment": "jsdom"
  }
}
