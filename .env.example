# Copy to .env and fill in. This file is tracked; .env is gitignored.
#
# Placeholders only — never put real secrets in this file.

# Your tailnet login as sent by Tailscale Serve in the `tailscale-user-login`
# header. This is an ACCESS control only (only your device reaches the app);
# identity comes from the IdP (see the OIDC_* block below).
OWNER_LOGIN=your-login@example.com

# --- IdP / OIDC (Task 8b) ----------------------------------------------------
# Browser-reachable issuer URL. This is the public URL the *browser* uses, not
# the compose-internal hostname. It must be same-site with the app URL so
# SameSite=Lax cookies and the logout hand-off work.
#
# Topology: Tailscale Serve on the single tailnet host.
#   - app:  https://<host>.<tailnet>.ts.net/        -> 127.0.0.1:3002 (Serve 443)
#   - idp:  https://<host>.<tailnet>.ts.net:8443/   -> 127.0.0.1:3003 (Serve 8443)
# Same host => same origin family => same-site. See README "Auth model".
#
# Example (replace the host): https://fedora.taila38130.ts.net:8443
IDP_ISSUER=change-me

# The app (RP) client registered on the IdP. The secret is REQUIRED in
# production: the IdP refuses to boot without it (no placeholder fallback).
# Generate: openssl rand -hex 32
OIDC_APP_CLIENT_ID=app
OIDC_APP_CLIENT_SECRET=change-me

# The app's callback URL, EXACTLY as the browser will use it (scheme+host+port+
# path). This single value must be byte-identical in three places:
#   1. this file (used by both the IdP registration and the app),
#   2. the Serve route for the app (port 443 -> 127.0.0.1:3002),
#   3. the browser URL after login.
# Example (replace the host): https://fedora.taila38130.ts.net/auth/callback
OIDC_APP_REDIRECT_URI=change-me

# Audience/resource mapping (prep for todo-service). `aud` is what resource
# servers check. Defaults preserve the notes API:
#   resource indicator -> audience, comma-separated.
OIDC_DEFAULT_RESOURCE=https://note-service
OIDC_AUDIENCE_MAP=https://note-service=note-service

# --- note-service resource server (Task 10, JWT-only) ------------------------
# note-service verifies access tokens offline against the IdP's JWKS. It fetches
# the keys over the internal compose network (default `http://idp:3003/jwks`)
# rather than the browser-facing issuer, so no tailnet round-trip is needed.
# Override only if the IdP is reachable at a different internal address.
# NOTE_SERVICE_IDP_JWKS_URL=http://idp:3003/jwks

# The audience note-service requires on access tokens (defaults to note-service).
# NOTE_SERVICE_AUDIENCE=note-service
